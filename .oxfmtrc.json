{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "preserve",
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "embeddedLanguageFormatting": "off",
  "jsdoc": false,
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "**/*.html",
    "**/*.svg",
    "**/*.toml",
    "**/*.graphql",
    "**/*.gql",
    "**/*.json5",
    ".agents/skills/**",
    ".claude-plugin/**",
    ".claude/skills/**",
    ".github/**",
    "claude-plugin/**",
    "docs/**",
    "tools/**",
    "pnpm-workspace.yaml",
    "packages/init/src/templates/**",
    "packages/cli/src/init/templates/**",
    "packages/relay/src/init/templates/**",
    "packages/fedify/src/cfworkers/fixtures/**",
    "packages/fedify/src/cfworkers/imports.ts",
    "packages/fedify/src/cfworkers/server.ts",
    "packages/fedify/src/cfworkers/runner.ts",
    "packages/fedify/src/cfworkers/selftest.ts",
    "packages/fedify/src/cfworkers/server.js",
    "packages/sqlite/src/sqlite.bun.ts",
    "**/dist/**",
    "**/dist-tests/**",
    "**/_fresh/**",
    "packages/vocab/src/*.yaml",
    "packages/vocab-tools/src/schema.yaml",
    "schema/bench/*.json",
    "test/smoke/**/.certs/**",
    "packages/cfworkers/test/**",
    "examples/sveltekit-sample/.prettierrc",
    "packages/amqp/npm/**",
    "packages/fedify/npm/**",
    "packages/testing/npm/**",
    "packages/fedify/apidoc/**",
    ".playwright-mcp/**",
    "examples/astro/.astro/**",
    "packages/fedify/src/cfworkers/server.js.map"
  ],
  "astro": true,
  "svelte": {
    "sortOrder": "none"
  },
  "overrides": [
    {
      "files": ["**/*.astro", "**/*.vue", "**/*.svelte"],
      "options": {
        "embeddedLanguageFormatting": "auto"
      }
    }
  ]
}
