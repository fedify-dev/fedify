{
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "JSON": {
      "language_servers": ["!deno", "!biome", "..."],
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "JavaScript": {
      "language_servers": ["!deno", "!biome", "..."],
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "hongdown",
          "arguments": ["-"]
        }
      },
      "language_servers": [
        "!deno",
        "!typescript-language-server",
        "!vtsls",
        "!biome",
        "..."
      ]
    },
    "TypeScript": {
      "language_servers": ["!deno", "!biome", "..."],
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "TSX": {
      "language_servers": ["!deno", "!biome", "..."],
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "YAML": {
      "language_servers": ["!deno", "!biome"],
      "enable_language_server": false,
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "JSONC": {
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "Astro": {
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "Vue.js": {
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    },
    "Svelte": {
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            "./node_modules/oxfmt/bin/oxfmt",
            "--stdin-filepath",
            "{buffer_path}",
            "--config",
            ".oxfmtrc.json"
          ]
        }
      }
    }
  },
  "show_wrap_guides": true,
  "wrap_guides": [80]
}
