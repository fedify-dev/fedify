{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vitest",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "overrides": [
    {
      "files": [
        "packages/cli/**"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "examples/fresh/**"
      ],
      "rules": {
        "react/no-danger": "error",
        "react/no-danger-with-children": "error",
        "react/rules-of-hooks": "error"
      }
    }
  ],
  "rules": {
    "typescript/adjacent-overload-signatures": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-check": false,
        "ts-expect-error": "allow-with-description",
        "ts-ignore": "allow-with-description",
        "ts-nocheck": "allow-with-description",
        "minimumDescriptionLength": 1
      }
    ],
    "typescript/no-wrapper-object-types": "error",
    "typescript/no-unsafe-function-type": "error",
    "eslint/constructor-super": "error",
    "eslint/for-direction": "error",
    "eslint/getter-return": "error",
    "react/jsx-boolean-value": "error",
    "react/button-has-type": "error",
    "react/jsx-curly-brace-presence": [
      "error",
      {
        "propElementValues": "always"
      }
    ],
    "react/jsx-key": [
      "error",
      {
        "checkKeyMustBeforeSpread": false
      }
    ],
    "react/no-children-prop": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/no-unescaped-entities": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/jsx-props-no-spread-multi": "error",
    "react/void-dom-elements-no-children": "error",
    "eslint/no-array-constructor": "error",
    "eslint/no-async-promise-executor": "error",
    "eslint/no-await-in-loop": "warn",
    "eslint/no-case-declarations": "error",
    "eslint/no-class-assign": "error",
    "eslint/no-compare-neg-zero": "error",
    "eslint/no-cond-assign": "error",
    "eslint/no-console": "warn",
    "eslint/no-const-assign": "error",
    "eslint/no-constant-condition": [
      "error",
      {
        "checkLoops": false
      }
    ],
    "eslint/no-control-regex": "error",
    "eslint/no-debugger": "error",
    "eslint/no-delete-var": "error",
    "eslint/no-dupe-class-members": "error",
    "eslint/no-dupe-else-if": "error",
    "eslint/no-dupe-keys": "error",
    "eslint/no-duplicate-case": "error",
    "eslint/no-empty": "error",
    "eslint/no-empty-character-class": "error",
    "typescript/no-empty-interface": [
      "error",
      {
        "allowSingleExtends": true
      }
    ],
    "typescript/no-empty-object-type": [
      "error",
      {
        "allowInterfaces": "always"
      }
    ],
    "eslint/no-empty-pattern": "error",
    "eslint/no-ex-assign": "error",
    "typescript/no-explicit-any": "error",
    "eslint/no-extra-boolean-cast": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-func-assign": "error",
    "eslint/no-global-assign": "error",
    "eslint/no-import-assign": "error",
    "eslint/no-inner-declarations": "error",
    "eslint/no-invalid-regexp": "error",
    "eslint/no-irregular-whitespace": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "eslint/no-new-native-nonconstructor": "error",
    "eslint/no-obj-calls": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-redeclare": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/no-self-assign": "error",
    "eslint/no-setter-return": "error",
    "eslint/no-shadow-restricted-names": "error",
    "typescript/no-this-alias": "error",
    "eslint/no-this-before-super": "error",
    "eslint/no-unreachable": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-negation": "error",
    "eslint/no-unused-labels": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eslint/no-var": "error",
    "eslint/no-with": "error",
    "typescript/prefer-as-const": "error",
    "eslint/prefer-const": [
      "error",
      {
        "destructuring": "all"
      }
    ],
    "typescript/prefer-namespace-keyword": "error",
    "eslint/require-await": "error",
    "eslint/require-yield": "error",
    "eslint/use-isnan": "error",
    "eslint/valid-typeof": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-reflect-apply": "error",
    "import/no-duplicates": "error",
    "promise/no-nesting": "error",
    "promise/no-return-wrap": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-useless-escape": "error"
  },
  "ignorePatterns": [
    "**/pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".agents/skills/**",
    ".claude/skills/**",
    ".claude-plugin/**",
    ".github/**",
    "claude-plugin/**",
    "docs/**",
    "**/*.md",
    "**/*.html",
    "**/*.svg",
    "**/*.astro",
    "**/*.svelte",
    "**/*.vue",
    "**/*.css",
    "examples/cloudflare-workers/worker-configuration.d.ts",
    "packages/cli/src/init/templates/**",
    "packages/init/src/templates/**",
    "packages/cfworkers/test/**",
    "packages/fedify/src/cfworkers/dist/**",
    "packages/fedify/src/cfworkers/fixtures/**",
    "packages/fedify/src/cfworkers/imports.ts",
    "packages/fedify/src/cfworkers/server.ts",
    "packages/fedify/src/cfworkers/runner.ts",
    "packages/fedify/src/cfworkers/selftest.ts",
    "packages/fedify/src/cfworkers/server.js",
    "packages/fedify/src/cfworkers/server.js.map",
    "packages/sqlite/src/sqlite.bun.ts",
    "examples/fresh/_fresh/**",
    "examples/astro/.astro/**",
    "**/dist/**",
    "**/dist-tests/**",
    "**/node_modules/**",
    "**/npm/**",
    "**/apidoc/**",
    "**/*.test-report.xml",
    "tools/oxlint/anti-slop/**"
  ]
}
