{
  "deno": {
    "label": "Deno",
    "checkCommand": [
      "deno",
      "--version"
    ],
    "outputPattern": "^deno\\s+(\\d+\\.\\d+\\.\\d+\\b)",
    "minVersion": "2.0.0"
  },
  "bun": {
    "label": "Bun",
    "checkCommand": [
      "bun",
      "--version"
    ],
    "outputPattern": "^(\\d+\\.\\d+\\.\\d+$)",
    "minVersion": "1.1.0"
  },
  "node": {
    "label": "Node.js",
    "checkCommand": [
      "node",
      "--version"
    ],
    "outputPattern": "^v(\\d+\\.\\d+\\.\\d+$)",
    "minVersion": "22.0.0"
  }
}
