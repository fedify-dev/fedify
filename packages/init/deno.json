{
  "name": "@fedify/init",
  "version": "2.5.0",
  "license": "MIT",
  "exports": "./src/mod.ts",
  "imports": {
    "@inquirer/prompts": "npm:@inquirer/prompts@^7.8.4",
    "inquirer-toggle": "npm:inquirer-toggle@^1.0.1"
  },
  "exclude": ["dist/", "node_modules/"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/"
    ]
  },
  "tasks": {
    "check": "deno check src/**/*.ts",
    "run": "deno run --allow-all src/mod.ts",
    "update-init-deps": "node --experimental-strip-types scripts/update_init_deps.ts"
  },
  "test": {
    "exclude": ["src/test/**"]
  }
}
