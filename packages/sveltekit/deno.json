{
  "name": "@fedify/sveltekit",
  "version": "2.5.0",
  "license": "MIT",
  "imports": {
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.0.0"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "exclude": ["dist", "node_modules"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts",
      "compat/"
    ]
  },
  "tasks": {
    "check": "deno check src/*.ts",
    "test": "deno test --allow-net --allow-env"
  }
}
