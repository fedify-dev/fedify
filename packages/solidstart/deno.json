{
  "name": "@fedify/solidstart",
  "version": "2.2.18",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "exclude": [
    "dist",
    "node_modules"
  ],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check src/*.ts",
    "test": "deno test --allow-net --allow-env"
  },
  "imports": {
    "h3": "npm:h3@^1.15.0"
  }
}
