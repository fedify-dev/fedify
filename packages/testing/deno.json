{
  "name": "@fedify/testing",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "exclude": ["dist", "node_modules", "npm", "pnpm-lock.yaml"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "build": "pnpm build",
    "check": "deno check",
    "test": "deno test --allow-read --allow-net --allow-env",
    "test:node": {
      "dependencies": ["build"],
      "command": "node --experimental-transform-types --test"
    },
    "test:bun": {
      "dependencies": ["build"],
      "command": "bun test --timeout 15000"
    },
    "test-all": {
      "dependencies": ["test", "test:node", "test:bun"]
    }
  }
}
