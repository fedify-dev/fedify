{
  "name": "@fedify/lint",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./oxlint": "./src/oxlint.ts"
  },
  "imports": {
    "@fedify/fixture": "jsr:@fedify/fixture@^2.2.14",
    "eslint": "npm:eslint@^9.0.0",
    "estree": "npm:@types/estree@^1.0.8",
    "oxlint": "npm:oxlint@1.90.0"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/*.bench.d.*",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts",
      "src/lib/test.ts"
    ]
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-run --allow-sys --allow-write"
  }
}
