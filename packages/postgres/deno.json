{
  "name": "@fedify/postgres",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./kv": "./src/kv.ts",
    "./mq": "./src/mq.ts"
  },
  "exclude": ["dist", "node_modules"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/*.bench.d.*",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "check": "deno check src/*.ts",
    "test": "deno test --allow-net --allow-env"
  }
}
