{
  "name": "@fedify/relay",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "exclude": ["dist/", "node_modules/", "dist-tests/"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/*.bench.d.*",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "codegen": "deno task -f @fedify/vocab compile",
    "check": {
      "command": "deno check src/**/*.ts",
      "dependencies": ["codegen"]
    },
    "test": {
      "command": "deno test --allow-env",
      "dependencies": ["codegen"]
    }
  }
}
