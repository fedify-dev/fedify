{
  "name": "@fedify/relay",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "exclude": ["dist/", "node_modules/"],
  "publish": {
    "exclude": ["**/*.test.ts", "tsdown.config.ts"]
  },
  "tasks": {
    "codegen": "deno task -f @fedify/vocab compile",
    "check": {
      "command": "deno check src/**/*.ts",
      "dependencies": ["codegen"]
    },
    "test": {
      "command": "deno test --allow-env",
      "dependencies": ["codegen"]
    }
  }
}
