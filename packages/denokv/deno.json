{
  "name": "@fedify/denokv",
  "version": "2.5.0",
  "license": "MIT",
  "imports": {
    "es-toolkit": "npm:es-toolkit@^1.46.1"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "exclude": ["dist", "node_modules"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/"
    ]
  },
  "tasks": {
    "check": "deno check src/*.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write"
  }
}
