{
  "name": "@fedify/vocab",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "description": "Vocabularies library for @fedify/fedify",
  "author": {
    "name": "Hong Minhee",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "imports": {
    "fast-check": "npm:fast-check@^3.22.0",
    "fetch-mock": "npm:fetch-mock@^12.5.2",
    "jsonld": "npm:jsonld@^9.0.0",
    "temporal-polyfill": "npm:temporal-polyfill@^1.0.1"
  },
  "exclude": [
    "dist/",
    "dist-tests/",
    "node_modules/",
    "src/*.yaml",
    "src/runtime-test-modules.node.d.ts",
    "!src/vocab.ts"
  ],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/*.bench.d.*",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts",
      "scripts/"
    ]
  },
  "tasks": {
    "check": "deno check src/*.ts",
    "compile": "node --experimental-strip-types scripts/codegen.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-ffi --unstable-kv --trace-leaks --parallel"
  }
}
