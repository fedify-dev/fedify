{
  "extends": "../../tsconfig.node.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": [
    "dist",
    "dist-tests",
    "node_modules",
    // Workers code; checked by tsconfig.check.workers.json.
    "src/cfworkers/runner.ts",
    // Workers code; checked by tsconfig.check.workers.json.
    "src/cfworkers/selftest.ts",
    // The Workers test bundle entry; it imports modules generated by
    // test:cfworkers and is owned by that task.
    "src/cfworkers/server.ts",
    // Generated by the Workers test task.
    "src/cfworkers/imports.ts",
    // Generated by the Workers test task.
    "src/cfworkers/dist",
    // Deno script; owned by check:types:deno.
    "scripts/discover_tests.ts",
    // Deno script; owned by check:types:deno.
    "scripts/generate-map-local-vector.ts"
  ]
}
