{
  "name": "@fedify/express",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "express": "npm:express@^4.0.0"
  },
  "exclude": ["dist", "node_modules"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "check": "deno check *.ts",
    "test": "deno test --allow-all"
  }
}
