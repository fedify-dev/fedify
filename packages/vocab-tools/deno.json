{
  "name": "@fedify/vocab-tools",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "author": {
    "name": "Hong Minhee",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "imports": {
    "@cfworker/json-schema": "npm:@cfworker/json-schema@^4.1.1",
    "yaml": "npm:yaml@^2.9.0"
  },
  "exclude": [
    "dist",
    "node_modules",
    "src/schema.yaml",
    "src/runtime-test-modules.node.d.ts"
  ],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/*.bench.d.*",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "check": "deno check src/*.ts",
    "test": "deno test -A"
  }
}
