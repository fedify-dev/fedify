  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "description": "WebFinger client library for Fedify",
  "author": {
    "name": "Hong Minhee",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "imports": {
    "es-toolkit": "npm:es-toolkit@^1.46.1",
    "fetch-mock": "npm:fetch-mock@^12.5.4"
  },
  "exclude": ["dist", "node_modules", "dist-tests/"],
  "publish": {
