{
  "name": "@fedify/fastify",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "fastify": "npm:fastify@^5.2.0",
    "fastify-plugin": "npm:fastify-plugin@^5.0.1"
  },
  "exclude": ["dist", "node_modules"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "check": "deno check src/*.ts",
    "test": "deno test --allow-all"
  }
}
