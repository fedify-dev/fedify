{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fedify-cfworkers-test",
  "compatibility_date": "2024-12-01",
  "main": "src/mod.ts",
  "kv_namespaces": [
    {
      "binding": "KV1",
      "id": "00000000000000000000000000000000",
    },
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "fedify-cfworkers-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "Q1",
        "queue": "test-queue",
      },
    ],
    "consumers": [
      {
        "queue": "test-queue",
        "max_batch_timeout": 1,
      },
    ],
  },
}
