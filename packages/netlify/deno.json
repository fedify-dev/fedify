{
  "name": "@fedify/netlify",
  "version": "2.5.0",
  "license": "MIT",
  "imports": {
    "@netlify/async-workloads": "npm:@netlify/async-workloads@^0.0.106",
    "@netlify/blobs": "npm:@netlify/blobs@^11.0.3",
    "byte-encodings": "npm:byte-encodings@^1.0.11"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "exclude": ["dist", "node_modules"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "fixtures",
      "test",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "check": "deno check src/*.ts",
    "test": "deno test --allow-env --allow-read"
  }
}
