{
  "name": "@fedify/nuxt",
  "version": "2.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@nuxt/kit": "npm:@nuxt/kit@^4.0.0",
    "@nuxt/schema": "npm:@nuxt/schema@^4.0.0",
    "h3": "npm:h3@^1.15.0"
  },
  "exclude": ["dist", "node_modules"],
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/__snapshots__/",
      "**/__fixtures__/",
      "**/fixtures/",
      "**/testdata/",
      "**/test/",
      "**/tests/",
      "tsdown.config.ts"
    ]
  },
  "tasks": {
    "test": "deno test --allow-net --allow-env",
    "check": "deno check src/*.ts src/runtime/server/*.ts"
  }
}
